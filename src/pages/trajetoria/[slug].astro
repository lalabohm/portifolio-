---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { TYPE_LABEL, formatDate } from '../../lib/trajetoria';

export async function getStaticPaths() {
  const entries = await getCollection('trajetoria');
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout title={`${entry.data.title} — Larissa Böhm`}>
  <a href={`${import.meta.env.BASE_URL}trajetoria`} class="font-mono text-xs text-muted hover:text-accent">&larr; trajetória</a>

  <h1 class="font-display text-2xl md:text-3xl text-ink mt-4">
    {entry.data.title} <span class="text-accent">· {entry.data.org}</span>
  </h1>
  <p class="font-mono text-xs text-muted mt-2">
    {entry.data.role} · {formatDate(entry.data.dateStart)} – {entry.data.dateEnd ? formatDate(entry.data.dateEnd) : 'Atual'}
  </p>
  <span class="inline-block font-mono text-[10px] uppercase tracking-wide text-accent border border-line px-1.5 py-0.5 mt-3">
    {TYPE_LABEL[entry.data.type]}
  </span>

  <article class="prose prose-invert prose-headings:font-display prose-p:text-ink/90 mt-10 max-w-none">
    <Content />
  </article>

  {entry.data.link && (
    <a href={entry.data.link} target="_blank" rel="noopener noreferrer" class="inline-block mt-10 font-mono text-sm text-accent hover:underline">
      ver reel &rarr;
    </a>
  )}
</BaseLayout>
