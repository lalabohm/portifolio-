---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTrajetoriaPairs, TYPE_GROUPS, formatRange } from '../../lib/trajetoria';

const base = import.meta.env.BASE_URL;
const pairs = await getTrajetoriaPairs();
const groups = TYPE_GROUPS.map((g) => ({
  ...g,
  items: pairs.filter((p) => p.en.data.type === g.type),
})).filter((g) => g.items.length > 0);
---

<BaseLayout title="Trajetória — Larissa Böhm Araújo">
  <h1 class="font-display text-4xl font-semibold tracking-tight text-ink">
    <span data-i18n="en">Journey</span><span data-i18n="pt">Trajetória</span>
  </h1>
  <p class="mt-2.5 text-lg leading-relaxed text-muted" data-i18n="en">
    Organized as in the Lattes CV: research, professional experience, extension, teaching and complementary
    education. <a href="http://lattes.cnpq.br/5682267720222263" target="_blank" rel="noopener noreferrer" class="link">See Lattes</a>
  </p>
  <p class="mt-2.5 text-lg leading-relaxed text-muted" data-i18n="pt">
    Organizada como no Currículo Lattes: pesquisa, atuação profissional, extensão, ensino e formação complementar.
    <a href="http://lattes.cnpq.br/5682267720222263" target="_blank" rel="noopener noreferrer" class="link">Ver Lattes</a>
  </p>

  {groups.map((g) => (
    <section class="mt-11">
      <h2 class="section-title !mb-1.5 flex items-center gap-2.5">
        <span aria-hidden="true" class={`inline-block w-2.5 h-2.5 ${g.color}`}></span>
        <span data-i18n="en">{g.en}</span><span data-i18n="pt">{g.pt}</span>
      </h2>
      {g.items.map((pair) => {
        const en = pair.en.data;
        const pt = pair.pt?.data ?? en;
        const href = `${base}${en.projectSlug ? `projects/${en.projectSlug}` : `trajetoria/${pair.slug}`}`;
        return (
          <div class="grid grid-cols-1 sm:grid-cols-[160px_minmax(0,1fr)] gap-x-5 gap-y-1 py-4 border-b border-line2">
            <span class="font-mono text-[13px] text-primary sm:pt-1">
              <span data-i18n="en">{formatRange(en.dateStart, en.dateEnd, 'en', en.datePrecision)}</span>
              <span data-i18n="pt">{formatRange(pt.dateStart, pt.dateEnd, 'pt', pt.datePrecision)}</span>
            </span>
            <div>
              <a href={href} class="no-underline">
                <p class="text-lg font-semibold text-ink hover:text-accent transition-colors" data-i18n="en">{en.title}</p>
                <p class="text-lg font-semibold text-ink hover:text-accent transition-colors" data-i18n="pt">{pt.title}</p>
              </a>
              <p class="mt-0.5 text-base italic text-muted" data-i18n="en">{en.role} · {en.org}</p>
              <p class="mt-0.5 text-base italic text-muted" data-i18n="pt">{pt.role} · {pt.org}</p>
              <p class="mt-1.5 text-base leading-relaxed text-body" data-i18n="en">{en.summary}</p>
              <p class="mt-1.5 text-base leading-relaxed text-body" data-i18n="pt">{pt.summary}</p>
              {en.link && (
                <a href={en.link} target="_blank" rel="noopener noreferrer" class="link inline-block mt-1.5 font-mono text-[13px]" data-i18n="en">read more &rarr;</a>
              )}
              {pt.link && (
                <a href={pt.link} target="_blank" rel="noopener noreferrer" class="link inline-block mt-1.5 font-mono text-[13px]" data-i18n="pt">saiba mais &rarr;</a>
              )}
            </div>
          </div>
        );
      })}
    </section>
  ))}
</BaseLayout>
