---
import BaseLayout from '../layouts/BaseLayout.astro';
import BilingualProjectEntry from '../components/BilingualProjectEntry.astro';
import { getProjectPairs } from '../lib/projects';

const pairs = (await getProjectPairs()).filter((p) => p.en.data.featured);
---

<BaseLayout title="Larissa Böhm — Portfolio">
  <section class="mb-16 flex items-start justify-between gap-8">
    <div class="max-w-xl">
      <h1 class="font-display text-3xl md:text-4xl text-ink leading-tight">
        Larissa Böhm<span class="text-accent">.</span>
      </h1>
      <p class="text-base text-gray-500 mt-4 leading-relaxed" data-i18n="en">
        I focus on LLM security, agent architectures, and adversarial machine learning.
      </p>
      <p class="text-base text-gray-500 mt-4 leading-relaxed" data-i18n="pt">
        Foco em segurança de LLMs, arquiteturas de agentes e aprendizado de máquina adversarial.
      </p>
    </div>
    <img
      src={`${import.meta.env.BASE_URL}fotoLarissa.jpeg`}
      alt="Larissa Böhm"
      class="block w-20 h-20 sm:w-32 sm:h-32 rounded-full border border-line object-cover shrink-0"
    />
  </section>

  <section class="mb-16">
    <h2 class="font-mono text-lg text-muted uppercase tracking-wide mb-2" data-i18n="en">About me</h2>
    <h2 class="font-mono text-lg text-muted uppercase tracking-wide mb-2" data-i18n="pt">Sobre mim</h2>
    <p class="text-white text-lg max-w-xl leading-relaxed" data-i18n="en">
      Computer Science student at <a href="https://www.idp.edu.br/" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">IDP</a>, currently an intern at the Engineering
      Coordination of <a href="https://www.gov.br/cnpq" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">CNPq</a>, a Brazilian federal government agency. I work
      with ETL and contribute to initiatives focused on innovation with
      artificial intelligence.
    </p>
    <a href={`${import.meta.env.BASE_URL}trajetoria`} class="inline-block mt-4 font-mono text-sm text-accent hover:underline" data-i18n="en">
      See my journey &rarr;
    </a>
    <p class="text-white text-lg max-w-xl leading-relaxed" data-i18n="pt">
      Estudante de Ciência da Computação no <a href="https://www.idp.edu.br/" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">IDP</a>, atualmente estagiária na
      Coordenação de Engenharia do <a href="https://www.gov.br/cnpq" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">CNPq</a>, órgão do governo federal brasileiro.
      Trabalho com ETL e contribuo com iniciativas voltadas à inovação em
      inteligência artificial.
    </p>
    <a href={`${import.meta.env.BASE_URL}trajetoria`} class="inline-block mt-4 font-mono text-sm text-accent hover:underline" data-i18n="pt">
      Conheça a minha trajetória &rarr;
    </a>
  </section>

  <section class="mb-16">
    <h2 class="font-mono text-xs text-muted uppercase tracking-wide mb-2" data-i18n="en">Experience</h2>
    <h2 class="font-mono text-xs text-muted uppercase tracking-wide mb-2" data-i18n="pt">Experiência</h2>
    <div data-i18n="en">
      <p class="text-muted max-w-xl leading-relaxed">
        Intern, Engineering Coordination × CNPq — <a href={`${import.meta.env.BASE_URL}projects/cnpq-semantic-analysis`} class="text-accent hover:underline">read more</a>
      </p>
      <p class="text-muted max-w-xl leading-relaxed mt-2">
        Developer, Sprint IDP × BYD — <a href="https://www.linkedin.com/posts/larissa-b%C3%B6hm-77b538288_sprintidp-tecnologia-inovaaexaeto-activity-7350540861073436673-9of5?utm_source=share&utm_medium=member_desktop&rcm=ACoAAEXYqU8BQmzGNuTXu5GroCkUHA1nIMTN7e0" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">read more</a>
      </p>
      <p class="text-muted max-w-xl leading-relaxed mt-2">
        Participant, Innovation Hub × IDP — <a href="https://www.linkedin.com/posts/larissa-b%C3%B6hm-77b538288_participar-do-hub-de-inova%C3%A7%C3%A3o-foi-uma-oportunidade-activity-7263250077865963521-PFAw?utm_source=share&utm_medium=member_desktop&rcm=ACoAAEXYqU8BQmzGNuTXu5GroCkUHA1nIMTN7e0" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">read more</a>
      </p>
    </div>
    <div data-i18n="pt">
      <p class="text-muted max-w-xl leading-relaxed">
        Estagiária, Coordenação de Engenharia × CNPq — <a href={`${import.meta.env.BASE_URL}projects/cnpq-semantic-analysis`} class="text-accent hover:underline">saiba mais</a>
      </p>
      <p class="text-muted max-w-xl leading-relaxed mt-2">
        Desenvolvedora, Sprint IDP × BYD — <a href="https://www.linkedin.com/posts/larissa-b%C3%B6hm-77b538288_sprintidp-tecnologia-inovaaexaeto-activity-7350540861073436673-9of5?utm_source=share&utm_medium=member_desktop&rcm=ACoAAEXYqU8BQmzGNuTXu5GroCkUHA1nIMTN7e0" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">saiba mais</a>
      </p>
      <p class="text-muted max-w-xl leading-relaxed mt-2">
        Participante, Hub de Inovação × IDP — <a href="https://www.linkedin.com/posts/larissa-b%C3%B6hm-77b538288_participar-do-hub-de-inova%C3%A7%C3%A3o-foi-uma-oportunidade-activity-7263250077865963521-PFAw?utm_source=share&utm_medium=member_desktop&rcm=ACoAAEXYqU8BQmzGNuTXu5GroCkUHA1nIMTN7e0" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">saiba mais</a>
      </p>
    </div>
  </section>

  <section>
    <h2 class="font-mono text-xs text-muted uppercase tracking-wide mb-2" data-i18n="en">Featured projects</h2>
    <h2 class="font-mono text-xs text-muted uppercase tracking-wide mb-2" data-i18n="pt">Projetos em destaque</h2>
    <div>
      {pairs.map((pair) => <BilingualProjectEntry pair={pair} />)}
    </div>
  </section>
</BaseLayout>
