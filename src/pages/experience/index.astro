---
import BaseLayout from '../../layouts/BaseLayout.astro';

const experience = [
  {
    role: 'Intern, Engineering Coordination',
    org: 'CNPq',
    orgHref: 'https://www.gov.br/cnpq',
    period: 'Current',
    description: 'Work with ETL and contribute to initiatives focused on innovation with artificial intelligence, at the Brazilian federal government\'s National Council for Scientific and Technological Development.',
    stack: [],
  },
  {
    role: 'Developer, Sprint IDP',
    org: 'BYD',
    orgHref: 'https://www.linkedin.com/posts/larissa-b%C3%B6hm-77b538288_sprintidp-tecnologia-inovaaexaeto-activity-7350540861073436673-9of5?utm_source=share&utm_medium=member_desktop&rcm=ACoAAEXYqU8BQmzGNuTXu5GroCkUHA1nIMTN7e0',
    period: 'Apr 2025 – Jun 2025 · 3 mos',
    description: 'Project developed during Sprint IDP in partnership with BYD, building a digital platform connecting property owners interested in installing electric vehicle charging points with investors and charge point operators (CPOs). Responsible for implementing the interface, ensuring smooth navigation, responsive design, and integration with map and data APIs. Took part in meetings with a multidisciplinary team to define requirements, prototype features, and present the solution to BYD executives, including visits to the factory in Campinas and the office in São Paulo.',
    stack: ['React Native', 'TypeScript', 'API Management'],
  },
  {
    role: 'Participant, Innovation Hub',
    org: 'IDP',
    orgHref: 'https://www.linkedin.com/posts/larissa-b%C3%B6hm-77b538288_participar-do-hub-de-inova%C3%A7%C3%A3o-foi-uma-oportunidade-activity-7263250077865963521-PFAw?utm_source=share&utm_medium=member_desktop&rcm=ACoAAEXYqU8BQmzGNuTXu5GroCkUHA1nIMTN7e0',
    period: '',
    description: 'Took part in a project focused on digital safety for children and teenagers. Throughout the journey, we had the opportunity to meet with inspiring professionals from Procon, JusBrasil, Instituto Alana, and Anatel.',
    stack: [],
  },
];
---

<BaseLayout title="Experience — Larissa Böhm">
  <h1 class="font-display text-2xl text-ink mb-8">Experience</h1>

  <div>
    {experience.map((e) => (
      <div class="border-t border-line py-6">
        <div class="flex items-baseline justify-between gap-4">
          <h3 class="font-display text-lg text-ink">
            {e.role} · {e.orgHref ? (
              <a href={e.orgHref} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">{e.org}</a>
            ) : (
              <span class="text-accent">{e.org}</span>
            )}
          </h3>
          <span class="font-mono text-xs text-muted whitespace-nowrap">{e.period}</span>
        </div>
        <p class="text-muted mt-2 leading-relaxed">{e.description}</p>
        {e.stack.length > 0 && (
          <div class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-accent mt-3">
            {e.stack.map((s) => <span>{s}</span>)}
          </div>
        )}
      </div>
    ))}
  </div>
</BaseLayout>
