---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjectPairs, STATUS_LABEL } from '../../lib/projects';

export async function getStaticPaths() {
  const pairs = await getProjectPairs();
  return pairs.map((pair) => ({ params: { slug: pair.slug }, props: { pair } }));
}

const { pair } = Astro.props;
const enData = pair.en.data;
const ptData = pair.pt?.data ?? enData;

const { Content: ContentEn } = await pair.en.render();
const ContentPt = pair.pt ? (await pair.pt.render()).Content : ContentEn;

const status = STATUS_LABEL[enData.status] ?? { en: enData.status, pt: enData.status };
---

<BaseLayout title={`${enData.title} — Larissa Böhm`}>
  <a href={`${import.meta.env.BASE_URL}projects`} class="font-mono text-xs text-muted hover:text-accent" data-i18n="en">&larr; projects</a>
  <a href={`${import.meta.env.BASE_URL}projects`} class="font-mono text-xs text-muted hover:text-accent" data-i18n="pt">&larr; projetos</a>

  <h1 class="font-display text-2xl md:text-3xl text-ink mt-4" data-i18n="en">{enData.title}</h1>
  <h1 class="font-display text-2xl md:text-3xl text-ink mt-4" data-i18n="pt">{ptData.title}</h1>
  <p class="font-mono text-xs text-muted mt-2" data-i18n="en">{status.en}</p>
  <p class="font-mono text-xs text-muted mt-2" data-i18n="pt">{status.pt}</p>

  <div class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-accent mt-4">
    {enData.stack.map((s: string) => <span>{s}</span>)}
  </div>

  {enData.metrics && enData.metrics.length > 0 && (
    <ul class="font-mono text-xs text-muted flex flex-col gap-1 mt-4 border-l-2 border-line pl-4" data-i18n="en">
      {enData.metrics.map((m: string) => <li>{m}</li>)}
    </ul>
  )}
  {ptData.metrics && ptData.metrics.length > 0 && (
    <ul class="font-mono text-xs text-muted flex flex-col gap-1 mt-4 border-l-2 border-line pl-4" data-i18n="pt">
      {ptData.metrics.map((m: string) => <li>{m}</li>)}
    </ul>
  )}

  <article class="prose prose-invert prose-headings:font-display prose-p:text-ink/90 mt-10 max-w-none" data-i18n="en">
    <ContentEn />
  </article>
  <article class="prose prose-invert prose-headings:font-display prose-p:text-ink/90 mt-10 max-w-none" data-i18n="pt">
    <ContentPt />
  </article>

  {enData.repoUrl && (
    <a href={enData.repoUrl} class="inline-block mt-10 font-mono text-sm text-accent hover:underline" data-i18n="en">
      view repository
    </a>
  )}
  {ptData.repoUrl && (
    <a href={ptData.repoUrl} class="inline-block mt-10 font-mono text-sm text-accent hover:underline" data-i18n="pt">
      ver repositório
    </a>
  )}
</BaseLayout>
