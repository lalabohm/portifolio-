---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BilingualProjectEntry from '../../components/BilingualProjectEntry.astro';
import { getProjectPairs } from '../../lib/projects';

const pairs = await getProjectPairs();
---

<BaseLayout title="Projects — Larissa Böhm">
  <h1 class="font-display text-2xl text-ink mb-2" data-i18n="en">Projects</h1>
  <h1 class="font-display text-2xl text-ink mb-2" data-i18n="pt">Projetos</h1>
  <div>
    {pairs.map((pair) => <BilingualProjectEntry pair={pair} />)}
  </div>
</BaseLayout>
