---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BilingualProjectEntry from '../../components/BilingualProjectEntry.astro';
import { getProjectPairs } from '../../lib/projects';

const pairs = await getProjectPairs();
---

<BaseLayout title="Projects — Larissa Böhm Araújo">
  <h1 class="font-display text-4xl font-semibold tracking-tight text-ink">
    <span data-i18n="en">Projects</span><span data-i18n="pt">Projetos</span>
  </h1>
  <p class="mt-2 text-lg text-muted leading-relaxed" data-i18n="en">
    Research, coursework and competition projects, most recent first.
  </p>
  <p class="mt-2 text-lg text-muted leading-relaxed" data-i18n="pt">
    Projetos de pesquisa, de curso e de competições, do mais recente para o mais antigo.
  </p>
  <div class="mt-8 border-t-2 border-accent-soft">
    {pairs.map((pair) => <BilingualProjectEntry pair={pair} />)}
  </div>
</BaseLayout>
