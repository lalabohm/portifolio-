---
const links = [
  { href: `${import.meta.env.BASE_URL}projects`, label: 'projects' },
  { href: `${import.meta.env.BASE_URL}experience`, label: 'experience' },
  { href: `${import.meta.env.BASE_URL}ctf`, label: 'ctf' },
];
---

<header class="w-full border-b border-line">
  <div class="max-w-3xl mx-auto px-6 py-6 flex items-baseline justify-between">
    <a href={import.meta.env.BASE_URL} class="font-display text-lg text-ink no-underline">
      Larissa Böhm<span class="text-accent">.</span>
    </a>
    <nav class="flex gap-6 font-mono text-sm text-muted">
      {links.map((l) => (
        <a href={l.href} class="hover:text-accent transition-colors">{l.label}</a>
      ))}
    </nav>
  </div>
</header>
