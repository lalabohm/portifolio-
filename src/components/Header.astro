---
const links = [
  { href: `${import.meta.env.BASE_URL}projects`, en: 'projects', pt: 'projetos' },
  { href: `${import.meta.env.BASE_URL}trajetoria`, en: 'trajetória', pt: 'trajetória' },
  { href: `${import.meta.env.BASE_URL}ctf`, en: 'ctf', pt: 'ctf' },
];
---

<header class="w-full border-b border-line">
  <div class="max-w-3xl mx-auto px-6 py-6 flex items-baseline justify-between gap-4">
    <a href={import.meta.env.BASE_URL} class="font-display text-lg text-ink no-underline">
      Larissa Böhm<span class="text-accent">.</span>
    </a>
    <div class="flex items-baseline gap-6">
      <nav class="flex gap-6 font-mono text-sm text-muted">
        {links.map((l) => (
          <a href={l.href} class="hover:text-accent transition-colors">
            <span data-i18n="en">{l.en}</span><span data-i18n="pt">{l.pt}</span>
          </a>
        ))}
      </nav>
      <button
        id="lang-toggle"
        type="button"
        aria-label="Toggle language / Alternar idioma"
        class="font-mono text-xs text-muted border border-line rounded px-2 py-1 hover:text-accent hover:border-accent transition-colors"
      >
        <span data-i18n="en">PT</span><span data-i18n="pt">EN</span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('lang-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var root = document.documentElement;
      var next = root.getAttribute('data-lang') === 'pt' ? 'en' : 'pt';
      root.setAttribute('data-lang', next);
      root.lang = next;
      try {
        localStorage.setItem('portfolio-lang', next);
      } catch (e) {}
    });
  })();
</script>
