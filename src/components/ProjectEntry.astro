---
interface Props {
  title: string;
  subtitle?: string;
  summary: string;
  stack: string[];
  status: string;
  statusClass: string;
  year: number;
  award?: string;
  awardLabel: string;
  href: string;
  repoUrl?: string;
  labels: { summary: string; code: string };
}
const { title, subtitle, summary, stack, status, statusClass, year, award, awardLabel, href, repoUrl, labels } =
  Astro.props;
---

<article class="py-5 border-b border-line2">
  <p class="font-mono text-xs text-muted tracking-wide flex flex-wrap items-center gap-2">
    <span>{year}</span>
    <span aria-hidden="true">·</span>
    <span class={`pill ${statusClass}`}>{status}</span>
    {award && <span class="pill bg-accent-soft text-accent">{awardLabel}</span>}
  </p>
  <h3 class="mt-2 text-xl font-semibold leading-snug">
    <a href={href} class="text-ink hover:text-accent transition-colors no-underline">
      {title}{subtitle && <span class="font-normal">: {subtitle}</span>}
    </a>
  </h3>
  <p class="mt-2 text-[17px] leading-relaxed text-body">{summary}</p>
  {award && <p class="mt-2 text-base text-body"><strong class="font-semibold text-ink">{award}</strong></p>}
  <p class="mt-2 font-mono text-xs text-muted">{stack.join(' · ')}</p>
  <p class="mt-2 font-mono text-[13px]">
    <a href={href} class="link">{labels.summary}</a>
    {repoUrl && (
      <>
        {' · '}
        <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="link">{labels.code}</a>
      </>
    )}
  </p>
</article>
