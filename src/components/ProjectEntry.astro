---
interface Props {
  title: string;
  summary: string;
  stack: string[];
  status: string;
  metrics?: string[];
  href: string;
  repoUrl?: string;
}
const { title, summary, stack, status, metrics = [], href, repoUrl } = Astro.props;
---

<div class="group border-t border-line py-8">
  <div class="flex flex-col gap-3">
    <div class="flex items-baseline justify-between gap-4">
      <a href={href} class="no-underline">
        <h3 class="font-display text-xl text-ink group-hover:text-accent transition-colors">
          {title}
        </h3>
      </a>
      <span class="font-mono text-xs text-muted whitespace-nowrap">{status}</span>
    </div>
    <p class="text-muted leading-relaxed">{summary}</p>
    <div class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-accent">
      {stack.map((s) => <span>{s}</span>)}
    </div>
    {metrics.length > 0 && (
      <ul class="font-mono text-xs text-muted flex flex-col gap-1 mt-1">
        {metrics.map((m) => <li>— {m}</li>)}
      </ul>
    )}
    {repoUrl && (
      <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-accent hover:underline w-fit">
        github &rarr;
      </a>
    )}
  </div>
</div>
