---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Technical portfolio — offensive security, LLM/agent security, and CTF.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('portfolio-lang');
          var lang = stored === 'en' || stored === 'pt'
            ? stored
            : ((navigator.language || '').toLowerCase().indexOf('pt') === 0 ? 'pt' : 'en');
          document.documentElement.setAttribute('data-lang', lang);
          document.documentElement.lang = lang;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="font-body min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 w-full max-w-3xl mx-auto px-6 py-16">
      <slot />
    </main>
    <Footer />
  </body>
</html>
